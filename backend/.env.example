# Development only. This is the EXISTING Supabase PostgreSQL database, not a new database.
# Copy to backend/.env (ignored), fill locally, never commit secrets.
APP_ENV=development
HOST=127.0.0.1
PORT=3002
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# Confirm the active project's algorithm before production use.
SUPABASE_JWT_ALGORITHMS=ES256,RS256
ALLOWED_ORIGINS=http://localhost:3000

# Get a direct or session-pooler URI from Supabase > Connect.
# The HTTP SUPABASE_URL and service-role API key are not a PostgreSQL URI/password.
# URL-encode special characters in the password. Use sslmode=verify-full.
# If needed, add sslrootcert=<URL-encoded absolute path to the Supabase CA>.
# Production allows only these two query keys, once each; no target/session overrides.
DATABASE_URL=
DATABASE_MAX_CONNS=5

# For integration tests ONLY: a disposable local/test PostgreSQL database.
# Never point this at production.
SETPIECE_TEST_DATABASE_URL=

# Optional IANA zone; otherwise use the backend host's local zone.
# Match the Next.js server timezone to preserve profile date formatting.
# PROFILE_TIME_ZONE=America/Vancouver

# Optional READ-ONLY production schema PREPARE check; no fixtures or user rows.
# Set in the test process environment, not in committed configuration.
# SETPIECE_SCHEMA_DATABASE_URL=

# Phase 2A only: separate DISPOSABLE loopback DB named setpiece_m2_*; never Supabase.
# Requires APP_ENV=development and sslmode=disable. Leave unset for normal preview.
# LIFECYCLE_DATABASE_URL=
# Empty fixture database for lifecycle tests (process environment only):
# SETPIECE_LIFECYCLE_TEST_DATABASE_URL=
# Populated disposable database for startup/worker tests:
# SETPIECE_LIFECYCLE_SERVER_TEST_DATABASE_URL=

# Phase 2B fixtures: NEW EMPTY guarded setpiece_m2_test_* local database only.
# SETPIECE_VOTING_TEST_DATABASE_URL=

# Optional isolated local media server; never use existing production credentials.
# LOCAL_LIVEKIT_URL=ws://127.0.0.1:7880
# LOCAL_LIVEKIT_API_KEY=devkey
# LOCAL_LIVEKIT_API_SECRET=secret

# Phase 4A: optional local-only canonical profile store. Never use the Supabase URI.
# Uses APP_ENV=development, host 127.0.0.1, DB name setpiece_m4_*, sslmode=disable.
# When set, all profile/ranking/statistics reads use this SAME local database.
# PROFILE_DATABASE_URL=
# Fresh empty SQL fixture DB named setpiece_m4_test_* (test process only):
# SETPIECE_ACCOUNT_TEST_DATABASE_URL=
# Frontend .env.local opt-in (rebuild; default remains legacy):
# NEXT_PUBLIC_PROFILE_BACKEND=go
# GO_API_URL=http://127.0.0.1:3002

# Phase 4B: guarded local community store, also used by profile/account reads/writes.
# Must equal PROFILE_DATABASE_URL if both are set. Requires prepared schema + migration 0003.
# COMMUNITY_DATABASE_URL=
# Fresh EMPTY loopback setpiece_m4_test_* database (test process environment only):
# SETPIECE_COMMUNITY_TEST_DATABASE_URL=
# Frontend flag selects community AND canonical profiles; rebuild after changes:
# NEXT_PUBLIC_COMMUNITY_BACKEND=go

# Phase 4C measurements ONLY: NEW EMPTY local database, never the application DB.
# Test process environment; backend .env is not loaded by go test.
# Host 127.0.0.1, name setpiece_m4_perf_*, exactly sslmode=disable.
# SETPIECE_PERFORMANCE_TEST_DATABASE_URL=

# Phase 5 shared local rehearsal ONLY: all modules use one pool/database.
# APP_ENV=development; host 127.0.0.1; name setpiece_m5_*; exactly sslmode=disable.
# DATABASE_MAX_CONNS >= 2 (one connection holds the lifecycle lease).
# Leave DATABASE_URL, PROFILE_DATABASE_URL, COMMUNITY_DATABASE_URL and LIFECYCLE_DATABASE_URL unset.
# REHEARSAL_DATABASE_URL=
# Fresh EMPTY fixture only (test process, not .env):
# SETPIECE_REHEARSAL_TEST_DATABASE_URL=

# Existing development Supabase project (explicitly authorized; never a fixture).
# See DEVELOPMENT.md. Loopback HOST, APP_ENV=development, DATABASE_MAX_CONNS>=2.
# Unset every other database URL. Use restricted setpiece_app, port 5432,
# sslmode=verify-full and the matching project; never put the admin URI here.
# DEVELOPMENT_PROJECT_REF=
# DEVELOPMENT_DATABASE_URL=

# Authorized hosted application mode (see PRODUCTION.md).
# APP_ENV=production, HOST=0.0.0.0; one replica (free-plan sleeping accepted by the user).
# Unset every other database URL and DEVELOPMENT_PROJECT_REF/LOCAL_LIVEKIT_*.
# PRODUCTION_PROJECT_REF=
# PRODUCTION_DATABASE_URL=
# DATABASE_CA_PEM=
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
